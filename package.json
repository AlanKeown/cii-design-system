{
  "name": "cii-design-system",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @cii/docs",
    "dev:portal": "npm run dev --workspace @cii/community-portal",
    "build:packages": "npm run build --workspace @cii/tokens && npm run build --workspace @cii/svelte",
    "build": "npm run build:packages && npm run build --workspace @cii/docs && npm run build --workspace @cii/community-portal",
    "check": "npm run check:typescript && npm run check:tooling && npm run build:packages && npm run check --workspaces --if-present",
    "test": "npm run test:unit && playwright test --project portal --project portal-components --project docs",
    "test:portal": "playwright test --project portal",
    "test:docs": "playwright test --project docs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:tooling": "tsc --project tsconfig.json",
    "test:unit": "node --experimental-strip-types --test scripts/*.test.ts && npm run test:unit --workspaces --if-present",
    "check:typescript": "node --experimental-strip-types scripts/check-typescript.ts",
    "db:start": "supabase start -x studio,imgproxy,storage-api,edge-runtime,logflare,vector,supavisor,realtime",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:lint": "supabase db lint --level warning --fail-on warning",
    "db:types": "node --experimental-strip-types scripts/generate-database-types.ts",
    "profile:portal:ssr": "node --experimental-strip-types scripts/profile-portal-ssr.ts",
    "test:portal-live": "node --experimental-strip-types scripts/test-portal-live.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@sveltepress/theme-default": "^8.11.0",
    "@sveltepress/vite": "^1.10.0",
    "@types/node": "^24.19.2",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.0",
    "sirv": "^3.0.2",
    "supabase": "2.122.0",
    "svelte": "^5.57.2",
    "typescript": "~6.0.3",
    "vite": "^8.3.5"
  },
  "overrides": {
    "@sveltejs/kit": "$@sveltejs/kit",
    "@sveltejs/enhanced-img": "^1.0.0"
  }
}

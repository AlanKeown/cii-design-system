# Optional: omit ALL values to serve the local demo. For vite dev use .env.local;
# for Wrangler preview put the same values in .dev.vars (both ignored).
# Obtain the public URL/publishable key from `npx supabase status` locally.
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
PUBLIC_TURNSTILE_SITE_KEY=
PUBLIC_AUTH_GITHUB_ENABLED=false
# Do not add secrets, service-role keys, SMTP credentials or OAuth secrets here.

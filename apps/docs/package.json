{
  "name": "@cii/docs",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "sync:design": "node --experimental-strip-types ../../scripts/sync-design-docs.ts",
    "predev": "npm run sync:design",
    "dev": "vite --host 0.0.0.0 --port 5188 --strictPort",
    "prebuild": "npm run sync:design",
    "build": "vite build",
    "preview": "node --experimental-strip-types ../../scripts/preview.ts 4188",
    "precheck": "npm run sync:design",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@cii/svelte": "0.2.0",
    "@cii/tokens": "0.2.0"
  },
  "devDependencies": {
    "svelte": "^5.57.2",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "vite": "^8.3.5",
    "typescript": "~6.0.3",
    "svelte-check": "^4.7.7",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltepress/vite": "^1.10.0",
    "@sveltepress/theme-default": "^8.11.0"
  }
}

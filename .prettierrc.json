{
  "singleQuote": true,
  "trailingComma": "none",
  "plugins": ["prettier-plugin-svelte"],
  "overrides": [
    {
      "files": "*.svelte",
      "options": {
        "parser": "svelte"
      }
    },
    {
      "files": "*.md",
      "options": {
        "proseWrap": "always"
      }
    },
    {
      "files": "packages/maps/tests/fixtures/accuracy-report.md",
      "options": {
        "proseWrap": "preserve"
      }
    }
  ]
}

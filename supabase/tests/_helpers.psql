-- Shared fixtures for the pgTAP suite. Included by each test with \ir; the .psql extension keeps
-- pg_prove from running it as a test. Everything lives in pg_temp and in transaction-local
-- settings, so it disappears when each test file rolls back.
--
-- Users:  ann (owner of org 'a'), ben (owner of org 'b'), cat (owner of org 'c').
-- Org 'a' and org 'b' are seeded with pg_temp.demo(); org 'c' is empty.

create extension if not exists pgtap with schema extensions;

create function pg_temp.ann() returns uuid language sql immutable as $$ select 'a0000000-0000-4000-8000-000000000001'::uuid $$;
create function pg_temp.ben() returns uuid language sql immutable as $$ select 'b0000000-0000-4000-8000-000000000002'::uuid $$;
create function pg_temp.cat() returns uuid language sql immutable as $$ select 'c0000000-0000-4000-8000-000000000003'::uuid $$;

create function pg_temp.org(p_name text) returns uuid language sql stable as $$
  select current_setting('test.org_' || p_name)::uuid
$$;

-- Sets the JWT claims auth.uid() reads, without changing the database role.
create function pg_temp.claims(p_user uuid) returns void language sql as $$
  select set_config('request.jwt.claims', json_build_object('sub', p_user, 'role', 'authenticated')::text, true);
$$;

-- Acts as a signed-in user through the Data API: claims plus the authenticated role.
-- Undo with `reset role;`.
create function pg_temp.login(p_user uuid) returns void language plpgsql as $$
begin
  perform pg_temp.claims(p_user);
  perform set_config('role', 'authenticated', true);
end;
$$;

create function pg_temp.make_user(p_id uuid, p_email text) returns void language sql as $$
  insert into auth.users (id, instance_id, aud, role, email, raw_app_meta_data, raw_user_meta_data, created_at, updated_at)
  values (p_id, '00000000-0000-0000-0000-000000000000', 'authenticated', 'authenticated', p_email, '{}', '{}', now(), now());
$$;

-- A small version of initialRecords from apps/community-portal/src/lib/data.ts.
create function pg_temp.demo() returns jsonb language sql immutable as $$
  select '{
    "Programs": [
      {"kind": "Programs", "id": "P-101", "name": "Food pantry", "status": "Active", "type": "Food relief",
       "location": "Parramatta", "date": "2026-09-01", "capacity": 40, "participants": 28},
      {"kind": "Programs", "id": "P-102", "name": "Wellbeing circle", "status": "Pending", "type": "Wellbeing",
       "location": "Sydney", "date": "2026-10-01", "capacity": 24, "participants": 18}
    ],
    "Members": [
      {"kind": "Members", "id": "M-1001", "name": "Amelia Thompson", "email": "amelia@example.org",
       "phone": "0400 123 456", "status": "Active", "type": "Community member", "location": "Parramatta",
       "tags": "Family support", "date": "2026-10-23", "notes": "Prefers contact by email.", "programId": "P-101"},
      {"kind": "Members", "id": "M-1002", "name": "Noah Williams", "email": "noah@example.org",
       "status": "Active", "type": "Volunteer", "location": "Sydney", "date": "2026-09-14"},
      {"kind": "Members", "id": "M-1003", "name": "Olivia Chen", "email": "", "status": "Pending",
       "type": "Donor", "location": "Penrith", "date": "2026-08-02"}

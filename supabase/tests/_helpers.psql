       "type": "Housing", "location": "Parramatta", "date": "2026-10-20", "memberId": "M-1001",
       "notes": "Private case note."}
    ],
    "Administration": []
  }'::jsonb
$$;

-- Runs a statement as the current role and reports how many rows it touched.
create function pg_temp.affected(p_sql text) returns integer language plpgsql as $$
declare
  v_count integer;
begin
  execute p_sql;
  get diagnostics v_count = row_count;
  return v_count;
end;
$$;

create function pg_temp.can_read(p_table text, p_org uuid) returns boolean language plpgsql as $$
declare
  v_found boolean;
begin
  execute format('select exists (select 1 from public.%I where org_id = $1)', p_table) into v_found using p_org;
  return v_found;
end;
$$;

-- Tries a minimal valid insert, then rolls it back. True if RLS allowed it.
create function pg_temp.can_insert(p_table text, p_org uuid) returns boolean language plpgsql as $$
begin
  begin
    execute case p_table
      when 'members' then format(
        'insert into public.members (org_id, name, status, date) values (%L, ''Probe'', ''Active'', ''2026-01-01'')', p_org)
      when 'programs' then format(
        'insert into public.programs (org_id, name, status, date, capacity, participants) values (%L, ''Probe'', ''Active'', ''2026-01-01'', 1, 0)', p_org)
      when 'events' then format(
        'insert into public.events (org_id, name, status, date, attendees) values (%L, ''Probe'', ''Upcoming'', ''2026-01-01'', 0)', p_org)
      when 'donations' then format(
        'insert into public.donations (org_id, name, status, date, amount) values (%L, ''Probe'', ''Needs receipt'', ''2026-01-01'', 1)', p_org)
      when 'cases' then format(
        'insert into public.cases (org_id, name, status, date, priority, member_id) values (%L, ''Probe'', ''Open'', ''2026-01-01'', ''Normal'', ''M-1001'')', p_org)
    end;
    raise exception using errcode = 'P0099', message = 'probe';
  exception
    when sqlstate 'P0099' then return true;
    when insufficient_privilege then return false;
  end;
end;
$$;

-- Tries to update every row of the organisation, then rolls it back. True if any row was writable.
create function pg_temp.can_update(p_table text, p_org uuid) returns boolean language plpgsql as $$
declare
  v_count integer := 0;
begin
  begin
    execute format('update public.%I set location = location || '' '' where org_id = $1', p_table) using p_org;
    get diagnostics v_count = row_count;
    raise exception using errcode = 'P0099', message = 'probe';
  exception
    when sqlstate 'P0099' then return v_count > 0;
    when insufficient_privilege then return false;
  end;
end;
$$;

-- Creates the three users, their workspaces through ensure_workspace(), and seeds orgs 'a' and 'b'.
create function pg_temp.setup() returns void language plpgsql as $$
declare
  v_org uuid;
begin
  perform pg_temp.make_user(pg_temp.ann(), 'ann@example.test');
  perform pg_temp.make_user(pg_temp.ben(), 'ben@example.test');
  perform pg_temp.make_user(pg_temp.cat(), 'cat@example.test');

  perform pg_temp.claims(pg_temp.ann());
  select w.org_id into v_org from public.ensure_workspace() w;
  perform set_config('test.org_a', v_org::text, true);
  perform public.seed_demo_workspace(v_org, pg_temp.demo());

  perform pg_temp.claims(pg_temp.ben());
  select w.org_id into v_org from public.ensure_workspace() w;
  perform set_config('test.org_b', v_org::text, true);
  perform public.seed_demo_workspace(v_org, pg_temp.demo());

  perform pg_temp.claims(pg_temp.cat());
  select w.org_id into v_org from public.ensure_workspace() w;
  perform set_config('test.org_c', v_org::text, true);

  perform set_config('request.jwt.claims', '', true);
end;
$$;

-- pgTAP's functions live in the extensions schema; tests call them while acting as a user.
-- Rolled back with the rest of the test.
grant usage on schema extensions to authenticated;

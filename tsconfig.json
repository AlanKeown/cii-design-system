{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "allowJs": false,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "playwright.config.ts",
    "scripts/**/*.ts",
    "packages/tokens/**/*.ts"
  ]
}

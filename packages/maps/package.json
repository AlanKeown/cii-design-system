{
  "name": "@cii/maps",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/*.svelte"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    "./leaflet": {
      "types": "./dist/leaflet.d.ts",
      "development": "./src/leaflet.ts",
      "default": "./dist/leaflet.js"
    },
    "./svelte": {
      "types": "./dist/svelte/index.d.ts",
      "development": "./src/svelte/index.ts",
      "svelte": "./dist/svelte/index.js",
      "default": "./dist/svelte/index.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "development": "./src/testing.ts",
      "default": "./dist/testing.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "development": "./src/config/index.ts",
      "default": "./dist/config/index.js"
    },
    "./config/schema.json": {
      "development": "./src/config/map.schema.json",
      "default": "./dist/config/map.schema.json"
    },
    "./config/extensions": {
      "types": "./dist/config/extensions.d.ts",
      "development": "./src/config/extensions.ts",
      "default": "./dist/config/extensions.js"
    }
  },
  "scripts": {
    "build": "node --experimental-strip-types scripts/generate-config.ts --check --build && tsc -p tsconfig.build.json && svelte-package -i src/svelte -o dist/svelte --tsconfig tsconfig.svelte.json",
    "check": "node --experimental-strip-types scripts/generate-config.ts --check && tsc -p tsconfig.json && svelte-check --tsconfig tsconfig.svelte.json",
    "test:unit": "node --experimental-strip-types scripts/generate-config.ts --check && node --experimental-strip-types --test tests/*.test.ts",
    "generate:crs": "node --experimental-strip-types scripts/generate-crs.ts",
    "generate:config": "node --experimental-strip-types scripts/generate-config.ts",
    "generate:transform-fixtures": "node --experimental-strip-types scripts/generate-transform-fixtures.ts",
    "generate:accuracy-fixtures": "node --experimental-strip-types scripts/postgis-accuracy.ts --write",
    "test:accuracy": "node --experimental-strip-types scripts/postgis-accuracy.ts --check",
    "test:browser:serve": "vite build --config tests/browser/fixtures/vite.worker.config.ts && vite --config tests/browser/fixtures/vite.config.ts --host 127.0.0.1 --port 4185 --strictPort",
    "spike:sqlite": "node --experimental-strip-types scripts/generate-sqlite-spike.ts && CII_SQLITE_BENCHMARK=1 playwright test --config ../../playwright.maps.config.ts sqlite-benchmark",
    "spike:vertices": "node --experimental-strip-types scripts/spike-vertices.ts",
    "spike:oapif": "node --experimental-strip-types scripts/spike-oapif.ts",
    "spike:grids": "node --experimental-strip-types scripts/spike-grids.ts",
    "audit:target": "node --experimental-strip-types scripts/audit-target-postgis.ts",
    "spike:audit": "node --experimental-strip-types scripts/spike-target-audit.ts"
  },
  "devDependencies": {
    "@cii/svelte": "0.2.0",
    "@sqlite.org/sqlite-wasm": "3.54.1-build1",
    "@sveltejs/package": "^3.0.1",
    "@types/leaflet": "^1.9.22",
    "@types/sql.js": "1.4.11",
    "ajv": "^8.20.0",
    "geotiff": "3.1.0-beta.0",
    "json-schema-to-typescript": "^16.0.0",
    "leaflet": "1.9.4",
    "maplibre-gl": "6.15.0",
    "ol": "10.11.0",
    "proj4": "2.20.9",
    "sql.js": "1.15.2",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7"
  },
  "peerDependencies": {
    "@cii/svelte": "^0.2.0",
    "ajv": "^8.20.0",
    "leaflet": ">=1.9.4 <2",
    "proj4": ">=2.20.9 <3",
    "svelte": "^5.57.2"
  },
  "peerDependenciesMeta": {
    "leaflet": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "ajv": {
      "optional": true
    }
  },
  "dependencies": {
    "@cii/tokens": "0.2.0",
    "@xmldom/xmldom": "0.9.12"
  }
}
